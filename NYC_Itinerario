    const icon=L.divIcon({
      className:'',
      html:`<div style="background:${col};width:${size}px;height:${size}px;border-radius:50%;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.3)"></div>`,
      iconSize:[size,size],iconAnchor:[size/2,size/2]
    });
    const dayLabel=d>0?`<br><span style="font-size:10px;font-weight:700;color:${col}">${DAY_LABELS[d]||''}</span>`:'';
    const m=L.marker([p.lat,p.lng],{icon}).addTo(_mainMap);
    m.bindPopup(`<strong>${p.name}</strong><br><small>${p.addr}</small>${dayLabel}`);
    _mainMarkers.push(m);
  });

  // Fit bounds if filtering by day
  if(dayFilter!=='all'&&_mainMarkers.length>0){
    const group=L.featureGroup(_mainMarkers);
    _mainMap.fitBounds(group.getBounds().pad(0.2));
  } else {
    _mainMap.setView([40.7500,-73.9800],13);
  }
}

