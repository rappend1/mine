// ── CONVERSOR ─────────────────────────────────────────────────────────────────
let convRate=null,convDir='usd-ars';

async function initConversor(){
  // Use exchangerate-api (free tier)
  try{
    const res=await fetch('https://api.exchangerate-api.com/v4/latest/USD');
    const data=await res.json();
    convRate=data.rates?.ARS||null;
    if(convRate){
      document.getElementById('conv-rate-display').innerHTML=
        `💱 <strong>1 USD = ${convRate.toLocaleString('es-AR',{minimumFractionDigits:0,maximumFractionDigits:0})} ARS</strong> · Tasa oficial · Actualizado ${new Date().toLocaleDateString('es-AR')}`;
      convertMoney();
    } else {
      throw new Error('No ARS rate');
    }
  } catch(e){
    // Fallback: use a reasonable estimate
    convRate=950;
    document.getElementById('conv-rate-display').innerHTML=
      `💱 <strong>1 USD ≈ ${convRate.toLocaleString('es-AR')} ARS</strong> · Tasa estimada (sin conexión)`;
    convertMoney();
  }
}

function convertMoney(){
  if(!convRate)return;
  const input=parseFloat(document.getElementById('conv-from').value)||0;
  const result=convDir==='usd-ars'?input*convRate:input/convRate;
  const toLabel=convDir==='usd-ars'?'ARS':'USD';
  const fromLabel=convDir==='usd-ars'?'USD':'ARS';
  document.getElementById('conv-result').textContent=
    result.toLocaleString('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2});
  document.getElementById('conv-result-label').textContent=
    `${fromLabel} → ${toLabel} · Tasa: 1 USD = ${convRate.toLocaleString('es-AR',{maximumFractionDigits:0})} ARS`;
}

function swapCurrency(){
  convDir=convDir==='usd-ars'?'ars-usd':'usd-ars';
  const fl=document.getElementById('conv-from-label');
  const tl=document.getElementById('conv-to-label');
  if(convDir==='usd-ars'){fl.textContent='USD';tl.textContent='ARS';}
  else{fl.textContent='ARS';tl.textContent='USD';}
  convertMoney();
}

