function initFoodMap(){
  const map=L.map('food-map').setView([40.7500,-73.9800],13);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',{attribution:'© OpenStreetMap © CartoDB',subdomains:'abcd',maxZoom:19}).addTo(map);
  window._foodMap=map;
  window._foodMarkers=[];
  updateFoodMapMarkers();
  renderFoodChecklist();
}
function updateFoodMapMarkers(){
  const map=window._foodMap;
  window._foodMarkers.forEach(m=>map.removeLayer(m));
  window._foodMarkers=[];
  const filtered=FOOD.filter(f=>{
    if(foodSearchQ&&!f.name.toLowerCase().includes(foodSearchQ)&&!f.addr.toLowerCase().includes(foodSearchQ))return false;
    if(foodFilter==='almuerzo-cena')return f.type==='almuerzo-cena';
    if(foodFilter==='merienda')return f.type==='merienda';
    if(foodFilter==='must')return f.must;
    return true;
  });
  filtered.forEach(f=>{
    const checked=ST.foodChecked[f.id];
    if(checked)return; // Hide already-tried places from map
    const emoji=f.must?'⭐':f.type==='merienda'?'☕':'🍽️';
    const icon=L.divIcon({className:'',html:`<div style="font-size:18px;line-height:1;text-shadow:0 1px 3px rgba(0,0,0,.4)">${emoji}</div>`,iconSize:[22,22],iconAnchor:[11,11]});
    const m=L.marker([f.lat,f.lng],{icon}).addTo(map);
    m.bindPopup(`<strong>${f.name}</strong><br><small>${f.addr}</small><br><small>${f.price}</small>${f.note?`<br><em>${f.note}</em>`:''}`);
    window._foodMarkers.push(m);
  });
}
function toggleFoodCheck(id){
  const newVal=!ST.foodChecked[id];
  ST.foodChecked[id]=newVal;
  saveST();
  renderFoodChecklist();
  if(window._foodMap)updateFoodMapMarkers();
  if(window.fbReady)window.fbSetFoodCheck(id,newVal).catch(e=>console.warn('FB food',e));
}
function renderFoodChecklist(){
  const cont=document.getElementById('food-checklist');
  const filtered=FOOD.filter(f=>{
    // Filtro por tipo
    if(foodFilter==='almuerzo-cena'&&f.type!=='almuerzo-cena')return false;
    if(foodFilter==='merienda'&&f.type!=='merienda')return false;
    if(foodFilter==='must'&&!f.must)return false;
    // Filtro por búsqueda
    if(foodSearchQ){
      const q=foodSearchQ.toLowerCase();
      const matchName=f.name.toLowerCase().includes(q);
      const matchAddr=f.addr.toLowerCase().includes(q);
      const matchNote=(f.note||'').toLowerCase().includes(q);
      if(!matchName&&!matchAddr&&!matchNote)return false;
    }
    return true;
  });
  const countEl=document.getElementById('food-count');
  if(countEl){
    if(!foodSearchQ&&foodFilter==='all'){
      countEl.textContent='';
    } else {
      countEl.textContent=filtered.length+' resultado'+(filtered.length!==1?'s':'');
    }
  }
  if(filtered.length===0){
    cont.innerHTML=`<div class="empty-state" style="grid-column:1/-1;padding:40px 20px">
      <div class="big">🔍</div>
      <p>No hay resultados${foodSearchQ?' para "<strong>'+foodSearchQ+'</strong>"':''}</p>
    </div>`;
    return;
  }
  cont.innerHTML=filtered.map(f=>{
    const checked=ST.foodChecked[f.id]?true:false;
    const emoji=f.type==='merienda'?'☕':'🍽️';
    const mustTag=f.must?'<span class="fci-type fci-meal">⭐ Must</span>':'';
    const typeTag=f.type==='merienda'?'<span class="fci-type fci-merienda">☕ Merienda/Postre</span>':'<span class="fci-type fci-meal">🍽️ Almuerzo/Cena</span>';
    return `<div class="food-check-item${checked?' checked':''}" onclick="toggleFoodCheck('${f.id}')">
      <div class="fci-check">${checked?'✓':''}</div>
      <div class="fci-body">
        <div class="fci-name">${emoji} ${f.name}</div>
        <div class="fci-meta">${typeTag}${mustTag}<span>${f.price}</span></div>
        ${f.note?`<div style="font-size:11px;color:var(--ink3);margin-top:2px">${f.note}</div>`:''}
        <a class="fci-maps-link" href="${f.maps}" target="_blank" onclick="event.stopPropagation()">📍 ${f.addr} ↗</a>
      </div>
    </div>`;
  }).join('');
}

