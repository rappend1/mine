function toggleTicket(ticketId){
  if(!ST.tickets)ST.tickets={};
  const newVal=!ST.tickets[ticketId];
  ST.tickets[ticketId]=newVal;
  saveST();
  // Optimistic UI update
  const el=document.getElementById('ticket_'+ticketId);
  if(el){
    el.classList.toggle('done',newVal);
    el.querySelector('.ticket-check-box').textContent=newVal?'✓':'';
    el.querySelector('.ticket-check-label').textContent=newVal?'✅ Entrada sacada':'🎟️ Marcar entrada como sacada';
  }
  // Sync to Firebase
  if(window.fbReady)window.fbSetTicket(ticketId,newVal).catch(e=>console.warn('FB ticket',e));
}

function renderDay(dayData){
  const dm=DAY_META[dayData.day];
  let stops=dayData.stops||[];
  // Día 5 (Miércoles): itinerario fijo — grupo completo
  const id='day'+dayData.day;
  let stopsHtml=stops.map(s=>{
    let ftHtml='';
    if(s.ft){
      const ft=s.ft==='ft_village'?FT_VILLAGE:FREE_TOURS.find(f=>f.id===s.ft);
      if(ft)ftHtml=`<div class="stop-ft">
        <div class="stop-ft-name">🎙️ ${ft.name}</div>
        <div class="stop-ft-meta">
          <span>🕙 <strong>${ft.hour}</strong></span>
          <span>📍 <strong>${ft.meeting}</strong></span>
          <span>⏱ <strong>${ft.duration}</strong></span>
          <span>💵 <strong>${ft.propina}</strong></span>
        </div>
        <div>
          <a class="stop-ft-btn" href="${ft.url}" target="_blank">Reservar gratis ↗</a>
          <a class="stop-ft-maps" href="${ft.meetingMaps}" target="_blank">📍 Cómo llegar</a>
        </div>
      </div>`;
    }
    let optsHtml='';
    if(s.opts)optsHtml=`<div class="stop-options"><strong>Opciones</strong>${s.opts}</div>`;
    let ticketHtml='';
    if(s.ticket&&s.ticketId){
      const done=ST.tickets&&ST.tickets[s.ticketId];
      ticketHtml=`<div class="ticket-check${done?' done':''}" id="ticket_${s.ticketId}" onclick="toggleTicket('${s.ticketId}')">
        <div class="ticket-check-box">${done?'✓':''}</div>
        <div class="ticket-check-label">${done?'✅ Entrada sacada':'🎟️ Marcar entrada como sacada'}</div>
      </div>`;
    }
    return `<div class="stop-row">
      <div class="stop-time">${s.t}</div>
      <div class="stop-body">
        <div class="stop-name">${s.n}</div>
        ${s.addr?`<div style="font-size:11px;color:var(--ink3);margin-top:1px;margin-bottom:2px">📍 ${s.addr}</div>`:''}
        ${s.note?`<div class="stop-note">${s.note}</div>`:''}
        ${ftHtml}${optsHtml}${ticketHtml}
      </div>
      ${s.p&&s.p!=='--'?`<div class="stop-price ${stopPriceClass(s.p)}">${s.p}</div>`:''}
    </div>`;
  }).join('');
  const ticketCount=stops.filter(s=>s.ticket).length;
  const ticketDone=stops.filter(s=>s.ticket&&s.ticketId&&ST.tickets&&ST.tickets[s.ticketId]).length;
  const ticketPill=ticketCount>0?`<span class="day-block-badge" style="background:rgba(26,92,184,.08);color:var(--blue)">🎟️ ${ticketDone}/${ticketCount}</span>`:'';
  return `<div class="day-block" id="${id}">
    <div class="day-block-header" onclick="toggleDay('${id}')">
      <div class="day-color-bar" style="background:${dm.color}"></div>
      <div class="day-block-info">
        <div class="day-block-name">${dm.label} — ${dm.name}</div>
        <div class="day-block-sub">${stops[0]?stops[0].n:''}</div>
      </div>
      ${ticketPill}
      <div class="day-block-toggle">▾</div>
    </div>
    <div class="day-stops">${stopsHtml}</div>
  </div>`;
}
function toggleDay(id){
  document.getElementById(id).classList.toggle('open');
}
function renderItinerary(){
  const cont=document.getElementById('itinerario-container');
