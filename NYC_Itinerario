// ── COUNTDOWN ────────────────────────────────────────────────────────────────
function initCountdown(){
  const TRIP_START=new Date('2026-11-21T09:30:00-05:00'); // JFK arrival
  const TRIP_END  =new Date('2026-11-29T22:00:00-05:00'); // Departure
  const el=document.getElementById('countdown-badge');
  if(!el)return;

  function update(){
    const now=new Date();
    if(now>=TRIP_START&&now<=TRIP_END){
      // We're in NYC!
      const dayNum=Math.floor((now-TRIP_START)/(1000*60*60*24))+1;
      el.innerHTML=`<div class="countdown-wrap"><span style="font-size:36px">🗽</span><div style="color:var(--gold2);font-size:22px;font-weight:800;font-family:'Playfair Display',serif">¡Estamos en Nueva York!</div><div style="color:rgba(255,255,255,.5);font-size:13px">Día ${Math.min(dayNum,9)} de 9 del viaje</div></div>`;
    } else if(now>TRIP_END){
      el.innerHTML=`<div class="countdown-wrap"><span style="font-size:36px">📸</span><div style="color:var(--gold2);font-size:22px;font-weight:800;font-family:'Playfair Display',serif">El viaje terminó. ¡Fue increíble!</div></div>`;
    } else {
      const diff=TRIP_START-now;
      const days=Math.floor(diff/(1000*60*60*24));
      const hrs=Math.floor((diff%(1000*60*60*24))/(1000*60*60));
      const mins=Math.floor((diff%(1000*60*60))/(1000*60));
      el.innerHTML=`<div class="countdown-wrap">
        <div style="display:flex;align-items:baseline;gap:6px">
          <span style="font-family:'Playfair Display',serif;font-size:42px;font-weight:900;color:var(--gold2);line-height:1">${days}</span>
          <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.45)">días</span>
          <span style="font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:rgba(255,255,255,.6);margin-left:8px">${String(hrs).padStart(2,'0')}h ${String(mins).padStart(2,'0')}m</span>
        </div>
        <div style="color:rgba(255,255,255,.5);font-size:13px">para aterrizar en Nueva York ✈️</div>
      </div>`;
    }
  }
  update();
  setInterval(update,30000); // update every 30s
}

