  grid.innerHTML=filteredSP.map(p=>{
    const myScore=scoreUser&&ST.scores[p.id]?ST.scores[p.id][scoreUser]||0:0;
    const allScores=ST.scores[p.id]?Object.values(ST.scores[p.id]).filter(s=>s>0):[];
    const avg=allScores.length?allScores.reduce((a,b)=>a+b,0)/allScores.length:0;
    const avgStars=avg>0?`${'★'.repeat(Math.round(avg))}${'☆'.repeat(5-Math.round(avg))}`:'';
    const avgText=avg>0?`${avgStars} ${avg.toFixed(1)} · ${allScores.length} voto${allScores.length>1?'s':''}`:'Sin calificaciones aún';
    const stars=[1,2,3,4,5].map(n=>`<span class="star${myScore>=n?' lit':''}" onclick="setScore('${p.id}',${n})" onmouseover="hoverStar(this,${n},'${p.id}')" onmouseout="resetStar('${p.id}')">★</span>`).join('');
    const revs=ST.reviews[p.id]||[];
    const dayNum=PLACE_DAYS[p.name]||0;
    const dayLabel=dayNum>0?`<span style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:10px;background:${DAY_COLORS[dayNum]||'#555'};color:#fff">${DAY_LABEL_MAP[dayNum]||''}</span>`:'';
    const photo=PLACE_PHOTOS[p.name]||DEFAULT_PHOTO;
    const freeTag=p.cat&&p.cat==='parque'?'<span style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:10px;background:rgba(26,122,110,.15);color:var(--teal)">GRATIS</span>':'';
    const scoreBar=scoreUser?`
      <div style="margin-bottom:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3)">Calificar como ${USERS[scoreUser]?.name||scoreUser}</div>
      <div class="stars-row" id="stars_${p.id}">${stars}</div>`:`
      <div style="font-size:12px;color:var(--ink3);padding:8px 0">Elegí tu nombre arriba para calificar</div>`;
    const revsHtml=revs.length?`<div class="reviews-list" style="margin-top:10px">${revs.slice(0,3).map(r=>{const u=USERS[r.user];return`<div class="review-item"><div class="review-header"><div class="review-av" style="background:${u?.color||'#333'}">${u?.letter||'?'}</div><span class="review-name">${u?.name||r.user}</span><span class="review-stars">${'★'.repeat(r.score)}</span></div><div class="review-text">${r.text}</div></div>`;}).join('')}</div>`:'';
    return `<div class="score-card">
      <div style="position:relative;height:160px;overflow:hidden;border-radius:var(--rl) var(--rl) 0 0">
        <img src="${photo}" alt="${p.name}" style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy">
        <div style="position:absolute;top:10px;left:10px;display:flex;gap:5px">${dayLabel}${freeTag}</div>
        ${myScore>0?`<div style="position:absolute;top:10px;right:10px;background:rgba(0,0,0,.6);color:var(--gold2);font-size:13px;font-weight:700;padding:3px 8px;border-radius:10px">${'★'.repeat(myScore)}</div>`:''}
      </div>
      <div class="score-card-body">
        <div class="score-card-name">${p.name}</div>
        <div class="score-card-day">${p.cat?p.cat.toUpperCase():''}</div>
        ${avg>0?`<div style="font-size:12px;color:var(--gold);margin-bottom:8px">${avgText}</div>`:`<div style="font-size:11px;color:var(--ink3);margin-bottom:8px">${avgText}</div>`}
        ${scoreBar}
        <textarea class="comment-field" id="ta_${p.id}" placeholder="Contá la experiencia..." style="margin-top:8px"></textarea>
        <button class="save-btn" onclick="saveReview('${p.id}')">Guardar</button>
        ${revsHtml}
      </div>
    </div>`;
  }).join('');
}
function hoverStar(el,n,pid){
