function addGasto(){
  const desc=document.getElementById('g-desc').value.trim();
  const monto=parseFloat(document.getElementById('g-monto').value);
  if(!desc||!monto||monto<=0){alert('Ponele una descripción y un monto.');return;}
  if(!pagador2){alert('Elegí quién pagó.');return;}
  if(dividir2.length===0){alert('Elegí entre quiénes dividir.');return;}
  const item={desc,monto,pagador:pagador2,divide:[...dividir2],date:new Date().toLocaleDateString('es-AR')};
  document.getElementById('g-desc').value='';
  document.getElementById('g-monto').value='';
  if(window.fbReady){
    window.fbAddGasto(item).catch(e=>console.warn('FB gasto error',e));
    // listener will update UI
  } else {
    ST.gastos.unshift({...item,id:'g'+Date.now()});
    saveST();renderGastos();
  }
}
function delGasto(id){
  if(window.fbReady){
    window.fbDelGasto(id).catch(e=>console.warn('FB del error',e));
    // listener will update UI
  } else {
    ST.gastos=ST.gastos.filter(g=>g.id!==id&&g.fbId!==id);
    saveST();renderGastos();
  }
}
function renderGastos(){
  // Render list
  const list=document.getElementById('gastos-list');
  if(ST.gastos.length===0){
    list.innerHTML='<div class="empty-state"><div class="big">💸</div><p>Sin gastos todavía. Agreguen el primero.</p></div>';
  } else {
    list.innerHTML=ST.gastos.map(g=>{
      const u=USERS[g.pagador];
      const divNames=g.divide.map(d=>USERS[d]?.name||d).join(', ');
      return `<div class="gasto-item">
        <div class="gi-avatar" style="background:${u?.color||'#333'}">${u?.letter||'?'}</div>
        <div class="gi-body">
          <div class="gi-desc">${g.desc}</div>
          <div class="gi-meta">Pagó <strong>${u?.name||g.pagador}</strong> · Divide: ${divNames}</div>
        </div>
        <div class="gi-amount">$${g.monto.toFixed(2)}</div>
        <button class="gi-del" onclick="delGasto('${g.fbId||g.id}')">×</button>
      </div>`;
    }).join('');
  }
  // Calcular balances
  const users=['reni','mateo','nico','benja'];
  const balance={reni:0,mateo:0,nico:0,benja:0};
  ST.gastos.forEach(g=>{
    const share=g.monto/g.divide.length;
    balance[g.pagador]=(balance[g.pagador]||0)+g.monto;
    g.divide.forEach(d=>{balance[d]=(balance[d]||0)-share;});
  });
  // ── Resumen total pagado por persona ──────────────────────────────
  const paidSummaryEl=document.getElementById('paid-summary');
  if(paidSummaryEl){
    const totPaid={reni:0,mateo:0,nico:0,benja:0};
    ST.gastos.forEach(g=>{if(g.pagador&&totPaid[g.pagador]!==undefined)totPaid[g.pagador]+=g.monto;});
    const grandTotal=Object.values(totPaid).reduce((a,b)=>a+b,0);
    paidSummaryEl.innerHTML=`
      <div style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px">Total pagado por persona</div>
      ${Object.entries(totPaid).map(([u,amt])=>{
        const uu=USERS[u];
        const pct=grandTotal>0?Math.round(amt/grandTotal*100):0;
        return`<div style="margin-bottom:10px">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
            <div style="display:flex;align-items:center;gap:8px">
              <div style="width:22px;height:22px;border-radius:50%;background:${uu.color};display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;color:#fff">${uu.letter}</div>
              <span style="font-size:13px;color:rgba(255,255,255,.8)">${uu.name}</span>
            </div>
            <span style="font-size:15px;font-weight:700;color:${amt>0?'var(--gold2)':'rgba(255,255,255,.3)'}">${amt>0?'$'+amt.toFixed(2):'$0'}</span>
          </div>
          <div style="height:5px;background:rgba(255,255,255,.1);border-radius:3px;overflow:hidden">
            <div style="height:100%;width:${pct}%;background:${uu.color};border-radius:3px;transition:width .4s ease"></div>
          </div>
        </div>`;
      }).join('')}
      <div style="border-top:1px solid rgba(255,255,255,.1);margin-top:10px;padding-top:10px;display:flex;justify-content:space-between;align-items:center">
        <span style="font-size:11px;color:rgba(255,255,255,.4)">Total del grupo</span>
        <span style="font-size:17px;font-weight:900;color:var(--gold2)">$${grandTotal.toFixed(2)}</span>
      </div>`;
  }
  // ── Balance ──────────────────────────────────────────────────────
  const bcont=document.getElementById('balance-content');
  bcont.innerHTML=users.map(u=>{
    const b=balance[u]||0;
    const uu=USERS[u];
    const cls=b>0.01?'br-pos':b<-0.01?'br-neg':'br-zero';
    const label=b>0.01?`le deben $${b.toFixed(2)}`:b<-0.01?`debe $${Math.abs(b).toFixed(2)}`:'está al día';
    return `<div class="balance-row">
      <div class="br-name" style="display:flex;align-items:center;gap:8px">
        <span style="width:22px;height:22px;border-radius:50%;background:${uu.color};display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;color:#fff">${uu.letter}</span>
        ${uu.name}
      </div>
      <div class="br-amount ${cls}">${label}</div>
    </div>`;
  }).join('');
  // Calcular transferencias mínimas
  const pos=users.filter(u=>(balance[u]||0)>0.01).map(u=>({u,b:balance[u]})).sort((a,b)=>b.b-a.b);
  const neg=users.filter(u=>(balance[u]||0)<-0.01).map(u=>({u,b:-balance[u]})).sort((a,b)=>b.b-a.b);
  const transfers=[];
  let pi=0,ni=0;
  const pb=[...pos],nb=[...neg];
  while(pi<pb.length&&ni<nb.length){
    const amt=Math.min(pb[pi].b,nb[ni].b);
    if(amt>0.01)transfers.push({from:nb[ni].u,to:pb[pi].u,amt});
    pb[pi].b-=amt;nb[ni].b-=amt;
    if(pb[pi].b<0.01)pi++;
    if(nb[ni].b<0.01)ni++;
  }
  const tcont=document.getElementById('transfers-content');
  if(transfers.length>0){
    tcont.innerHTML='<div style="font-size:10px;font-weight:700;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.1em;margin:16px 0 10px">Transferencias mínimas</div>'+
      transfers.map(t=>`<div class="transfer-row" id="tr-${t.from}-${t.to}" style="${ST.paidTransfers&&ST.paidTransfers[t.from+'_'+t.to]?'opacity:.4;text-decoration:line-through':''}" onclick="toggleTransferPaid('${t.from}_${t.to}')">
        <span class="transfer-from">${USERS[t.from]?.name||t.from}</span>
        <span style="color:rgba(255,255,255,.4)">→</span>
        <span class="transfer-to">${USERS[t.to]?.name||t.to}</span>
        <span class="transfer-amount">$${t.amt.toFixed(2)}</span>
        <span style="font-size:11px;color:rgba(255,255,255,.35);margin-left:4px">${ST.paidTransfers&&ST.paidTransfers[t.from+'_'+t.to]?'✅ Pagada':'Tocar para marcar como pagada'}</span>
      </div>`).join('');
  } else {
    tcont.innerHTML='';
  }
}

