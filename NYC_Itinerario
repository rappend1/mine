// ── FIREBASE LISTENERS ───────────────────────────────────────────────────────
function initFbListeners(){
  // Gastos (splitwise)
  if(window.fbListenGastos){
    window.fbListenGastos(items=>{
      ST.gastos=items;
      saveST();
      const el=document.getElementById('gastos-list');
      if(el)renderGastos();
    });
  }
  // Tickets (entradas sacadas)
  if(window.fbListenTickets){
    window.fbListenTickets(data=>{
      ST.tickets=data;
      saveST();
      // Refresh itinerary if visible
      const tab=document.getElementById('tab-itinerario');
      if(tab&&tab.classList.contains('visible'))renderItinerary();
    });
  }
  // Food checked
  if(window.fbListenFood){
    window.fbListenFood(data=>{
      ST.foodChecked=data;
      saveST();
      if(document.getElementById('food-checklist'))renderFoodChecklist();
      if(window._foodMap)updateFoodMapMarkers();
    });
  }
  // Free Tour reservations
  if(window.fbListenFtReserved){
    window.fbListenFtReserved(data=>{
      ST.ftReserved=data;
      saveST();
      const ftCont=document.getElementById('freetours-container');
      if(ftCont&&ftCont.children.length)renderFreeTours();
    });
  }
  // Scores
  if(window.fbListenScores){
    window.fbListenScores(data=>{
      // Merge Firebase scores into ST.scores
      Object.entries(data).forEach(([placeId,vals])=>{
        if(!ST.scores[placeId])ST.scores[placeId]={};
        Object.entries(vals).forEach(([k,v])=>{
          // k is "user_score" format
          const user=k.replace('_score','');
          if(v>0)ST.scores[placeId][user]=v;
        });
      });
      saveST();
      const sg=document.getElementById('score-grid');
      if(sg&&sg.children.length)renderScores();
    });
  }

  // Show sync indicator
  const syncEl=document.getElementById('fb-sync-badge');
  if(syncEl){syncEl.style.display='flex';syncEl.innerHTML='🔄 Conectando con Firebase...';}
  setTimeout(()=>{
    if(syncEl){syncEl.innerHTML='✅ Sincronizado en tiempo real';syncEl.style.background='rgba(26,122,110,.1)';syncEl.style.color='var(--teal)';}
  },2000);
}

