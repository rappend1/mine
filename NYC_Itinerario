<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NYC Nov 2026 — Reni, Mateo, Nico & Benja</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import{getFirestore,doc,setDoc,getDoc,onSnapshot,collection,addDoc,deleteDoc,serverTimestamp}
  from"https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

// ══════════════════════════════════════════════
// PEGAR AQUÍ EL firebaseConfig DEL PROYECTO NYC-2026
// ══════════════════════════════════════════════
const firebaseConfig={
  apiKey:"AIzaSyDxJSKCpRRTs5Q3H34DrTTZnoOQ9IxVkCs",
  authDomain:"nyc-2026-2ca56.firebaseapp.com",
  projectId:"nyc-2026-2ca56",
  storageBucket:"nyc-2026-2ca56.firebasestorage.app",
  messagingSenderId:"330032845839",
  appId:"1:330032845839:web:50027b9ca7d90414dbbf7a",
  measurementId:"G-FT3NG1DLZS"
};
// ══════════════════════════════════════════════

const fbApp=initializeApp(firebaseConfig);
const db=getFirestore(fbApp);

// ── GASTOS ────────────────────────────────────
window.fbAddGasto=async(item)=>{await addDoc(collection(db,"gastos"),{...item,ts:serverTimestamp()});};
window.fbDelGasto=async(id)=>{await deleteDoc(doc(db,"gastos",id));};
window.fbListenGastos=(cb)=>{
  onSnapshot(collection(db,"gastos"),snap=>{
    const items=[];
    snap.forEach(d=>items.push({...d.data(),fbId:d.id}));
    items.sort((a,b)=>(b.ts?.seconds||0)-(a.ts?.seconds||0));
    cb(items);
  });
};

// ── SCORES ────────────────────────────────────
window.fbSetScore=async(placeId,user,score)=>{
  await setDoc(doc(db,"scores",placeId),{[user+"_score"]:score},{merge:true});
};
window.fbSetReview=async(placeId,review)=>{
  await addDoc(collection(db,"reviews_"+placeId),{...review,ts:serverTimestamp()});
};
window.fbListenScores=(cb)=>{
  onSnapshot(collection(db,"scores"),snap=>{
    const scores={};
    snap.forEach(d=>{scores[d.id]=d.data();});
    cb(scores);
  });
};
window.fbListenReviews=(placeId,cb)=>{
  onSnapshot(collection(db,"reviews_"+placeId),snap=>{
    const revs=[];
    snap.forEach(d=>revs.push({...d.data(),fbId:d.id}));
    revs.sort((a,b)=>(b.ts?.seconds||0)-(a.ts?.seconds||0));
    cb(revs);
  });
};

// ── TICKETS (entradas sacadas) ────────────────
window.fbSetTicket=async(ticketId,done)=>{
  await setDoc(doc(db,"tickets","all"),{[ticketId]:done},{merge:true});
};
window.fbListenTickets=(cb)=>{
  onSnapshot(doc(db,"tickets","all"),snap=>{
    cb(snap.exists()?snap.data():{});
  });
};

// ── FOOD CHECKED ──────────────────────────────
window.fbSetFoodCheck=async(foodId,done)=>{
  await setDoc(doc(db,"food","checked"),{[foodId]:done},{merge:true});
};
window.fbListenFood=(cb)=>{
  onSnapshot(doc(db,"food","checked"),snap=>{
    cb(snap.exists()?snap.data():{});
  });
};

// ── FREE TOUR RESERVATIONS ─────────────────────────────────────────────────
window.fbSetFtReserved=async(ftId,done)=>{
  await setDoc(doc(db,"ft_reserved","all"),{[ftId]:done},{merge:true});
};
window.fbListenFtReserved=(cb)=>{
  onSnapshot(doc(db,"ft_reserved","all"),snap=>{
    cb(snap.exists()?snap.data():{});
  });
};

// ── READY ─────────────────────────────────────
window.fbReady=true;
document.dispatchEvent(new Event("fbReady"));
</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --ink:#0f0d0a;--ink2:#3a3630;--ink3:#7a7268;
  --paper:#faf8f4;--paper2:#f2ede5;--paper3:#e8e0d2;
  --red:#c8392b;--red2:#e85444;
  --gold:#c9922a;--gold2:#f5b942;
  --teal:#1a7a6e;--teal2:#22a693;
  --blue:#1a5cb8;--purple:#6b35a8;
  --border:#d8cfc0;--border2:#c4b89e;
  --r:10px;--rl:16px;
  --shadow:0 2px 12px rgba(0,0,0,.07);
  --shadow2:0 8px 32px rgba(0,0,0,.12);
}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;font-size:15px;line-height:1.6}
a,button,[onclick]{cursor:pointer}
input,textarea,select{cursor:text}
h1,h2,h3,h4{font-family:'Playfair Display',serif}

/* HERO */
.hero{position:relative;height:100vh;min-height:580px;max-height:820px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end}
.hero-bg{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1522083165195-3424ed129620?w=1600&q=85') center/cover no-repeat}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(10,8,6,.95) 0%,rgba(10,8,6,.55) 50%,rgba(10,8,6,.08) 100%)}
.hero-content{position:relative;z-index:2;padding:48px 44px}
.hero-eyebrow{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--gold2);margin-bottom:12px}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(48px,8vw,84px);font-weight:900;color:#fff;line-height:.92;margin-bottom:22px;letter-spacing:-2px}
.hero-title em{font-style:italic;color:var(--gold2);display:block}
.hero-pills{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.hero-pill{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(8px);border-radius:24px;padding:7px 14px;font-size:12px;color:rgba(255,255,255,.8);font-weight:500;white-space:nowrap}
.hero-travelers{display:flex;gap:6px;align-items:center}
.trav-av{width:32px;height:32px;border-radius:50%;border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;color:#fff;margin-right:-6px}
.trav-label{font-size:12px;color:rgba(255,255,255,.5);margin-left:14px;letter-spacing:.04em}

/* NAV */
nav{background:var(--ink);position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,.07)}
.nav-inner{max-width:1100px;margin:0 auto;display:flex;padding:0 20px;overflow-x:auto;scrollbar-width:none}
.nav-inner::-webkit-scrollbar{display:none}
.nav-btn{padding:15px 16px;font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.38);cursor:pointer;border:none;background:none;border-bottom:2px solid transparent;white-space:nowrap;transition:all .2s;font-family:inherit}
.nav-btn:hover{color:rgba(255,255,255,.65)}
.nav-btn.active{color:#fff;border-bottom-color:var(--gold2)}

/* SECTIONS */
.page-section{display:none;padding:48px 0 90px}
.page-section.visible{display:block}
.container{max-width:1100px;margin:0 auto;padding:0 24px}
.section-header{margin-bottom:36px}
.section-label{font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}
.section-title{font-size:clamp(24px,4vw,36px);font-weight:700;color:var(--ink);line-height:1.1}
.section-sub{font-size:14px;color:var(--ink3);margin-top:10px;max-width:560px;line-height:1.6}

/* ITINERARY */

.day-block{border:1px solid var(--border);border-radius:var(--rl);overflow:hidden;margin-bottom:14px;background:#fff;transition:box-shadow .2s}
.day-block:hover{box-shadow:var(--shadow)}
.day-block-header{display:flex;align-items:center;gap:14px;padding:16px 20px;cursor:pointer;user-select:none;transition:background .15s}
.day-block-header:hover{background:rgba(0,0,0,.015)}
.day-color-bar{width:5px;height:44px;border-radius:3px;flex-shrink:0}
.day-block-info{flex:1;min-width:0}
.day-block-name{font-size:13px;font-weight:700;color:var(--ink)}
.day-block-sub{font-size:11.5px;color:var(--ink3);margin-top:2px}
.day-block-badge{font-size:10px;font-weight:700;padding:3px 9px;border-radius:12px;white-space:nowrap;flex-shrink:0}
.day-block-toggle{font-size:18px;color:var(--ink3);transition:transform .25s;flex-shrink:0}
.day-block.open .day-block-toggle{transform:rotate(180deg)}
.day-stops{display:none;border-top:1px solid var(--border)}
.day-block.open .day-stops{display:block}
.stop-row{display:flex;gap:14px;padding:11px 20px;border-bottom:1px solid rgba(0,0,0,.04);align-items:flex-start;transition:background .12s}
.stop-row:hover{background:var(--paper)}
.stop-row:last-child{border-bottom:none}
.stop-time{font-size:11px;font-weight:600;color:var(--ink3);min-width:68px;padding-top:2px;flex-shrink:0}
.stop-body{flex:1;min-width:0}
.stop-name{font-size:13.5px;font-weight:600;color:var(--ink);line-height:1.3}
.stop-note{font-size:12px;color:var(--ink3);margin-top:2px;line-height:1.5}
.stop-ft{margin-top:8px;background:rgba(201,146,42,.06);border:1.5px solid rgba(201,146,42,.25);border-radius:9px;padding:10px 13px}
.stop-ft-name{font-size:12px;font-weight:700;color:var(--gold);margin-bottom:5px}
.stop-ft-meta{display:flex;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--ink3);margin-bottom:7px}
.stop-ft-btn{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:#fff;background:var(--gold);padding:5px 12px;border-radius:20px;text-decoration:none}
.stop-ft-maps{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--teal2);text-decoration:none;margin-left:8px;padding:5px 10px;border:1px solid rgba(26,122,110,.25);border-radius:20px}
.stop-price{font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:12px;white-space:nowrap;flex-shrink:0;margin-top:2px}
.sp-free{background:rgba(26,122,110,.1);color:var(--teal)}
.sp-paid{background:rgba(201,146,42,.1);color:var(--gold)}
.sp-other{background:rgba(120,112,100,.09);color:var(--ink3)}
.stop-options{background:rgba(200,57,43,.05);border-left:3px solid var(--red2);padding:8px 12px;margin-top:6px;border-radius:0 6px 6px 0;font-size:12px;color:var(--ink2);line-height:1.5}
.stop-options strong{font-size:9px;letter-spacing:.08em;text-transform:uppercase;display:block;margin-bottom:2px;color:var(--red);opacity:.8}
.day-geo{background:rgba(26,92,184,.05);border-top:1px solid rgba(26,92,184,.1);padding:10px 20px;font-size:11.5px;color:var(--blue)}
.heli-version-block{padding:12px 20px;background:rgba(107,53,168,.05);border-left:3px solid var(--purple);margin:8px 0}
.heli-version-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--purple);margin-bottom:4px}

/* FREE TOURS TAB */
.ft-card{background:#fff;border:1px solid var(--border);border-radius:var(--rl);overflow:hidden;margin-bottom:18px;box-shadow:var(--shadow)}
.ft-card-header{background:var(--ink);padding:18px 22px;display:flex;align-items:flex-start;gap:14px}
.ft-card-num{width:32px;height:32px;border-radius:50%;background:var(--gold);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex-shrink:0}
.ft-card-title{color:#fff;font-size:16px;font-weight:700;line-height:1.3;margin-bottom:3px}
.ft-card-day{font-size:11px;color:var(--gold2);font-weight:600}
.ft-card-body{padding:18px 22px}
.ft-card-desc{font-size:13px;color:var(--ink2);line-height:1.65;margin-bottom:14px}
.ft-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.ft-meta-item{background:var(--paper2);border-radius:var(--r);padding:10px 12px}
.ft-meta-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--ink3);margin-bottom:3px}
.ft-meta-val{font-size:13px;font-weight:600;color:var(--ink)}
.ft-meta-val a{color:var(--teal2);text-decoration:none}
.ft-meta-val a:hover{text-decoration:underline}
.ft-btn-row{display:flex;gap:8px;flex-wrap:wrap}
.ft-reserve-btn{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:700;color:#fff;background:var(--gold);padding:9px 18px;border-radius:var(--r);text-decoration:none;transition:opacity .15s}
.ft-reserve-btn:hover{opacity:.85}
.ft-maps-btn{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:600;color:var(--teal2);padding:9px 15px;border-radius:var(--r);border:1.5px solid rgba(26,122,110,.25);text-decoration:none;transition:all .15s}
.ft-maps-btn:hover{background:rgba(26,122,110,.06)}

/* FOOD MAP */
.food-filter-row{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:18px}
.food-map-wrap{height:420px;border-radius:var(--rl);overflow:hidden;border:1px solid var(--border);margin-bottom:20px;position:relative}
.food-legend{position:absolute;bottom:12px;left:12px;z-index:500;background:rgba(255,255,255,.96);border-radius:var(--r);padding:10px 14px;font-size:11px;color:var(--ink2);box-shadow:var(--shadow);border:1px solid var(--border)}
.food-legend-title{font-weight:700;margin-bottom:6px;color:var(--ink);font-size:12px}
.food-leg-row{display:flex;align-items:center;gap:7px;margin-bottom:3px}
.food-checklist{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin-top:24px}
.food-check-item{display:flex;align-items:flex-start;gap:10px;background:#fff;border:1.5px solid var(--border);border-radius:var(--r);padding:12px 14px;transition:all .15s;cursor:pointer}
.food-check-item.checked{background:rgba(26,122,110,.05);border-color:rgba(26,122,110,.3)}
.food-check-item.checked .fci-name{text-decoration:line-through;color:var(--ink3)}
.fci-check{width:20px;height:20px;border-radius:50%;border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;transition:all .15s}
.food-check-item.checked .fci-check{background:var(--teal);border-color:var(--teal);color:#fff}
.fci-body{flex:1;min-width:0}
.fci-name{font-size:13px;font-weight:600;color:var(--ink);margin-bottom:2px}
.fci-meta{font-size:11px;color:var(--ink3);display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.fci-type{font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;white-space:nowrap}
.fci-meal{background:rgba(200,57,43,.1);color:var(--red)}
.fci-merienda{background:rgba(201,146,42,.1);color:var(--gold)}
.fci-maps-link{font-size:11px;color:var(--teal2);text-decoration:none;margin-top:3px;display:inline-flex;align-items:center;gap:3px}
.fci-maps-link:hover{text-decoration:underline}

/* COSTOS */
.cost-hero-card{background:var(--ink);border-radius:var(--rl);padding:26px 30px;margin-bottom:20px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.cost-n{font-family:'Playfair Display',serif;font-size:48px;font-weight:900;color:#fff;letter-spacing:-2px;line-height:1}
.cost-pp-n{font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--gold2);line-height:1}
.ct-header{display:grid;grid-template-columns:1fr 110px 110px;padding:10px 18px;background:var(--paper2);font-size:10px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid var(--border);border-radius:var(--rl) var(--rl) 0 0}
.cost-table{background:#fff;border:1px solid var(--border);border-radius:0 0 var(--rl) var(--rl);overflow:hidden;margin-bottom:18px}
.ct-row{display:grid;grid-template-columns:1fr 110px 110px;padding:11px 18px;border-top:1px solid var(--border);align-items:center;gap:8px;transition:background .12s}
.ct-row:hover{background:var(--paper)}
.ct-ico{font-size:15px;margin-right:6px}
.ct-name{font-size:13px;color:var(--ink)}
.ct-pp{font-size:12px;color:var(--ink3);text-align:right}
.ct-x4{font-size:13px;font-weight:700;color:var(--ink);text-align:right}
.ct-real input{width:90px;border:1.5px solid var(--border);border-radius:8px;padding:5px 8px;font-size:12px;font-family:inherit;color:var(--ink);background:var(--paper);text-align:right;transition:border-color .15s}
.ct-real input:focus{outline:none;border-color:var(--border2)}
.ct-sub{background:var(--paper2);font-weight:700}
.ct-tot{background:var(--ink)}
.ct-tot .ct-name{color:#fff;font-weight:800}
.ct-tot .ct-pp{color:rgba(255,255,255,.45)}
.ct-tot .ct-x4{color:var(--gold2);font-size:15px;font-weight:900}
.ct-tot .ct-real input{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#fff}
.savings{background:rgba(26,122,110,.05);border:1px solid rgba(26,122,110,.18);border-radius:var(--rl);padding:20px 22px;margin-top:16px}
.savings-title{font-size:14px;font-weight:700;color:var(--teal);margin-bottom:12px}
.sav-item{display:flex;gap:9px;margin-bottom:8px;font-size:13px;color:var(--ink2);line-height:1.5;align-items:flex-start}

/* GASTOS (SPLITWISE) */
.gasto-form{background:#fff;border:1px solid var(--border);border-radius:var(--rl);padding:22px;margin-bottom:22px;box-shadow:var(--shadow)}
.gasto-form h3{font-size:18px;font-weight:700;color:var(--ink);margin-bottom:16px}
.gf-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.gf-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);margin-bottom:4px;display:block}
.gf-input{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--r);font-size:13px;font-family:inherit;color:var(--ink);background:var(--paper);transition:border-color .15s}
.gf-input:focus{outline:none;border-color:var(--border2)}
.gf-who{display:flex;gap:7px;flex-wrap:wrap;margin:10px 0}
.gf-who-btn{display:flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;border:2px solid var(--border);background:transparent;cursor:pointer;font-size:12px;font-weight:600;color:var(--ink3);transition:all .15s;font-family:inherit}
.gf-who-btn.on{border-color:var(--ink);background:var(--ink);color:#fff}
.gf-add-btn{padding:9px 20px;border-radius:20px;background:var(--ink);border:none;color:#fff;font-size:13px;font-weight:600;cursor:pointer;transition:opacity .15s;font-family:inherit;margin-top:6px}
.gf-add-btn:hover{opacity:.8}
.gastos-list{display:flex;flex-direction:column;gap:10px;margin-bottom:24px}
.gasto-item{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:12px 15px;display:flex;align-items:center;gap:12px}
.gi-avatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;color:#fff;flex-shrink:0}
.gi-body{flex:1;min-width:0}
.gi-desc{font-size:13px;font-weight:600;color:var(--ink)}
.gi-meta{font-size:11px;color:var(--ink3);margin-top:2px}
.gi-amount{font-size:16px;font-weight:700;color:var(--ink);white-space:nowrap}
.gi-del{background:none;border:none;color:var(--ink3);font-size:18px;cursor:pointer;padding:0 4px;transition:color .12s;line-height:1}
.gi-del:hover{color:var(--red)}
.balance-panel{background:var(--ink);border-radius:var(--rl);padding:22px 26px}
.balance-title{font-size:14px;font-weight:700;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.1em;margin-bottom:16px}
.balance-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.08)}
.balance-row:last-child{border-bottom:none}
.br-name{font-size:13px;color:rgba(255,255,255,.7)}
.br-amount{font-size:15px;font-weight:700}
.br-pos{color:var(--gold2)}
.br-neg{color:#ef9a9a}
.br-zero{color:rgba(255,255,255,.3)}
.transfer-row{display:flex;align-items:center;gap:10px;padding:9px 12px;background:rgba(255,255,255,.05);border-radius:var(--r);margin-top:8px;font-size:12.5px;color:rgba(255,255,255,.8)}
.transfer-from{color:var(--gold2);font-weight:600}
.transfer-to{color:var(--teal2);font-weight:600}
.transfer-amount{font-weight:700;color:#fff;margin-left:auto}

/* TIPS */
.tips-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-bottom:28px}
.tip-card{background:#fff;border:1px solid var(--border);border-radius:var(--rl);overflow:hidden;box-shadow:var(--shadow);transition:transform .2s,box-shadow .2s}
.tip-card:hover{transform:translateY(-2px);box-shadow:var(--shadow2)}
.tip-bar{height:4px}
.tip-body{padding:15px 17px}
.tip-eye{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}
.tip-n{font-size:14px;font-weight:700;color:var(--ink);margin-bottom:5px;line-height:1.3}
.tip-d{font-size:12.5px;color:var(--ink2);line-height:1.6;margin-bottom:8px}
.tip-link{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;color:var(--teal2);text-decoration:none;padding:5px 11px;border:1.5px solid rgba(26,122,110,.25);border-radius:20px;margin-top:2px;transition:all .15s}
.tip-link:hover{background:rgba(26,122,110,.08)}

/* PUNTUACIONES */
.score-user-sel{display:flex;gap:10px;margin-bottom:22px;flex-wrap:wrap}
.score-user-btn{display:flex;align-items:center;gap:8px;padding:10px 18px;border-radius:24px;border:2px solid var(--border);background:transparent;cursor:pointer;font-size:13px;font-weight:600;color:var(--ink3);transition:all .2s;font-family:inherit}
.score-user-btn.active{background:var(--ink);border-color:var(--ink);color:#fff}
.score-user-av{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex-shrink:0}
.score-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.score-card{background:#fff;border:1px solid var(--border);border-radius:var(--rl);overflow:hidden;box-shadow:var(--shadow);transition:transform .2s}
.score-card:hover{transform:translateY(-2px)}
.score-card-img{height:160px;overflow:hidden;background:var(--paper2)}
.score-card-img img{width:100%;height:100%;object-fit:cover;display:block}
.score-card-body{padding:14px 16px}
.score-card-name{font-size:13.5px;font-weight:600;color:var(--ink);margin-bottom:4px}
.score-card-day{font-size:10px;color:var(--ink3);margin-bottom:10px;text-transform:uppercase;letter-spacing:.06em;font-weight:600}
.stars-row{display:flex;gap:3px;margin-bottom:8px}
.star{font-size:22px;cursor:pointer;color:var(--border2);transition:color .1s,transform .1s;user-select:none;line-height:1}
.star:hover{transform:scale(1.2)}
.star.lit{color:var(--gold2)}
.avg-display{font-size:11px;color:var(--ink3);margin-bottom:8px}
.comment-field{width:100%;border:1.5px solid var(--border);border-radius:var(--r);padding:8px 10px;font-size:12px;font-family:inherit;color:var(--ink);background:var(--paper);resize:none;min-height:50px;margin-bottom:6px;transition:border-color .15s}
.comment-field:focus{outline:none;border-color:var(--border2)}
.save-btn{padding:6px 14px;border-radius:20px;font-size:11px;font-weight:600;cursor:pointer;border:none;background:var(--ink);color:#fff;transition:opacity .15s;font-family:inherit}
.save-btn:hover{opacity:.8}
.reviews-list{margin-top:8px;display:flex;flex-direction:column;gap:5px}
.review-item{background:var(--paper2);border-radius:8px;padding:8px 10px}
.review-header{display:flex;align-items:center;gap:6px;margin-bottom:3px}
.review-av{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0}
.review-name{font-size:11px;font-weight:600;color:var(--ink)}
.review-stars{font-size:11px;color:var(--gold2);margin-left:auto}
.review-text{font-size:11.5px;color:var(--ink2);line-height:1.5}

/* MAPA BAÑOS / LINKNYC */
.map-info-bar{background:var(--paper2);border:1px solid var(--border);border-radius:var(--r);padding:12px 16px;margin-bottom:16px;font-size:13px;color:var(--ink2);line-height:1.55}
.leaflet-map{height:460px;border-radius:var(--rl);overflow:hidden;border:1px solid var(--border);margin-bottom:16px}

/* TICKETS */
.ticket-check{display:flex;align-items:center;gap:8px;margin-top:8px;padding:7px 10px;background:rgba(26,92,184,.05);border:1.5px solid rgba(26,92,184,.15);border-radius:8px;cursor:pointer;transition:all .15s;user-select:none}
.ticket-check:hover{background:rgba(26,92,184,.09)}
.ticket-check.done{background:rgba(26,122,110,.06);border-color:rgba(26,122,110,.25)}
.ticket-check-box{width:18px;height:18px;border-radius:4px;border:2px solid rgba(26,92,184,.4);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;transition:all .15s}
.ticket-check.done .ticket-check-box{background:var(--teal);border-color:var(--teal);color:#fff}
.ticket-check-label{font-size:11.5px;font-weight:600;color:var(--blue)}
.ticket-check.done .ticket-check-label{color:var(--teal)}

/* COUNTDOWN */
.countdown-wrap{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.cd-num{font-family:'Playfair Display',serif;font-size:36px;font-weight:900;color:var(--gold2);line-height:1}
.cd-label{font-size:11px;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.1em}
.cd-sep{width:1px;height:36px;background:rgba(255,255,255,.15)}
.cd-msg{font-size:13px;color:rgba(255,255,255,.7);line-height:1.4;max-width:200px}
.cd-live{color:var(--gold2);font-weight:700;font-size:14px}

/* CLIMA */
.clima-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px;margin-bottom:24px}
.clima-card{background:#fff;border:1px solid var(--border);border-radius:var(--rl);padding:14px 12px;text-align:center;box-shadow:var(--shadow)}
.clima-date{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);margin-bottom:6px}
.clima-icon{font-size:28px;line-height:1;margin-bottom:6px}
.clima-temps{font-size:13px;font-weight:700;color:var(--ink)}
.clima-min{font-size:11px;color:var(--ink3)}
.clima-desc{font-size:10px;color:var(--ink3);margin-top:4px;line-height:1.3}
.clima-loading{text-align:center;padding:40px;color:var(--ink3);font-size:13px}

/* CONVERSOR */
.conv-card{background:#fff;border:1px solid var(--border);border-radius:var(--rl);padding:24px;max-width:460px;box-shadow:var(--shadow)}
.conv-row{display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.conv-input{flex:1;min-width:120px;padding:12px 14px;border:1.5px solid var(--border);border-radius:var(--r);font-size:18px;font-weight:700;font-family:inherit;color:var(--ink);background:var(--paper);transition:border-color .15s;outline:none}
.conv-input:focus{border-color:var(--border2)}
.conv-currency{font-size:13px;font-weight:700;color:var(--ink3);min-width:40px}
.conv-rate{font-size:12px;color:var(--ink3);margin-top:6px}
.conv-result-box{background:var(--paper2);border-radius:var(--r);padding:16px 18px;margin-top:12px;text-align:center}
.conv-result-n{font-family:'Playfair Display',serif;font-size:32px;font-weight:700;color:var(--teal);line-height:1}
.conv-result-label{font-size:12px;color:var(--ink3);margin-top:4px}
.conv-swap{padding:10px 14px;border-radius:var(--r);border:1.5px solid var(--border);background:transparent;cursor:pointer;font-size:18px;transition:all .15s;font-family:inherit}
.conv-swap:hover{background:var(--paper2)}

/* SEARCH BARS */
.search-bar-wrap{position:relative;margin-bottom:20px}
.search-bar{width:100%;padding:11px 16px 11px 40px;border:1.5px solid var(--border);border-radius:24px;font-size:14px;font-family:inherit;color:var(--ink);background:#fff;transition:border-color .15s,box-shadow .15s;outline:none}
.search-bar:focus{border-color:var(--border2);box-shadow:0 2px 12px rgba(0,0,0,.08)}
.search-bar-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--ink3);font-size:16px;pointer-events:none}
.search-bar-clear{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--ink3);font-size:20px;line-height:1;cursor:pointer;display:none;padding:0 4px;transition:color .12s}
.search-bar-clear.visible{display:block}
.search-bar-clear:hover{color:var(--red)}
.search-count-pill{display:inline-flex;align-items:center;font-size:11px;font-weight:600;color:var(--ink3);background:var(--paper2);padding:3px 10px;border-radius:12px;margin-left:8px}

/* SHARED */
.empty-state{text-align:center;padding:60px 20px;color:var(--ink3)}
.empty-state .big{font-size:48px;margin-bottom:12px}
.f-btn{padding:7px 14px;border-radius:24px;font-size:12px;font-weight:500;cursor:pointer;border:1.5px solid var(--border);background:transparent;color:var(--ink3);transition:all .15s;white-space:nowrap;font-family:inherit}
.f-btn:hover{border-color:var(--ink2);color:var(--ink)}
.f-btn.on{background:var(--ink);border-color:var(--ink);color:#fff}
@media(max-width:700px){
  .hero-content{padding:36px 24px}
  .gf-row,.ct-header,.ct-row{grid-template-columns:1fr 1fr}
  .ct-x4,.ct-real{display:none}
  .ft-meta-grid{grid-template-columns:1fr}
  .score-grid,.food-checklist,.tips-grid{grid-template-columns:1fr}
}
</style>
</head>
