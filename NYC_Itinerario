function parseDollar(s){
  if(!s)return 0;
  const n=parseFloat(String(s).replace(/[^0-9.]/g,''));
  return isNaN(n)?0:n;
}
function renderCosts(){
  const body=document.getElementById('cost-table-body');
  // Render rows (skip TOTAL row — we render it dynamically)
  const dataRows=COSTS.filter(r=>r[0]!=='💰');
  body.innerHTML=dataRows.map((r,i)=>{
    const isSub=r[0]==='—';
    const cls=isSub?'ct-row ct-sub':'ct-row';
    const realVal=ST.costsReal&&ST.costsReal[i]!==undefined?ST.costsReal[i]:'';
    return `<div class="${cls}">
      <span class="ct-name"><span class="ct-ico">${r[0]}</span>${r[1]}</span>
      <span class="ct-pp">${r[2]}</span>
      <span class="ct-real"><input type="text" placeholder="—" value="${realVal}" oninput="saveReal(${i},this.value)" style="width:100px;border:1.5px solid var(--border);border-radius:8px;padding:5px 8px;font-size:12px;font-family:inherit;color:var(--ink);background:var(--paper);text-align:right;transition:border-color .15s" onfocus="this.style.borderColor='var(--border2)'" onblur="this.style.borderColor='var(--border)'"></span>
    </div>`;
  }).join('');
  // Auto-calculate total row
  renderCostTotal();
}
function renderCostTotal(){
  const existing=document.getElementById('cost-total-row');
  if(existing)existing.remove();
  // Sum all real values
  const dataRows=COSTS.filter(r=>r[0]!=='💰'&&r[0]!=='—');
  let totalReal=0;
  let allEmpty=true;
  dataRows.forEach((_,i)=>{
    const v=ST.costsReal&&ST.costsReal[i]?parseDollar(ST.costsReal[i]):0;
    if(v>0){allEmpty=false;totalReal+=v;}
  });
  const body=document.getElementById('cost-table-body');
  const totDiv=document.createElement('div');
  totDiv.id='cost-total-row';
  totDiv.className='ct-row ct-tot';
  totDiv.innerHTML=`
    <span class="ct-name">💰 TOTAL POR PERSONA</span>
    <span class="ct-pp">~$1.436</span>
    <span class="ct-real" style="display:flex;align-items:center;justify-content:flex-end">
      ${allEmpty
        ? '<span style="font-size:12px;color:rgba(255,255,255,.3)">—</span>'
        : `<span style="font-size:16px;font-weight:900;color:var(--gold2)">$${totalReal.toFixed(2)}</span>`
      }
    </span>`;
  body.appendChild(totDiv);
}
function saveReal(i,val){
  if(!ST.costsReal)ST.costsReal={};
  ST.costsReal[i]=val;
  saveST();
  renderCostTotal();
}

